# Application server
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Temporary local administrator. Change before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123admin

# PostgreSQL
DATABASE_URL=postgresql://northstar:northstar@localhost:5432/northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=northstar
POSTGRES_DB=northstar

# Optional for future private Bybit account features.
# Public candle data does not require credentials.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# SDK endpoint selection. Use "bytick" if the default Bybit host is redirected
# or unavailable in your region. The matching WebSocket host is selected
# automatically; explicit URL overrides are normally unnecessary.
BYBIT_API_REGION=default
BYBIT_BASE_URL=
BYBIT_WS_URL=

# Portfolio value of 1R for accepted strategy notifications.
STRATEGY_RISK_USD=100
